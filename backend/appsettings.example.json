{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=pricetracker;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "PriceTrackerAPI",
    "Audience": "PriceTrackerClient",
    "ExpiryDays": 7,
    "ExpiryHours": 0,
    "ExpiryMinutes": 0
  },
  "Firebase": {
    "CredentialPath": "firebase-adminsdk.json",
    "RemoteConfig": {
      "PriceDropThresholdPercentParameter": "price_drop_min_percent",
      "FallbackPriceDropThresholdPercent": 1,
      "CacheMinutes": 5
    }
  },
  "Sentry": {
    "Enabled": true,
    "Dsn": "",
    "ApiToken": "",
    "OrgSlug": "",
    "ProjectSlug": "",
    "BaseUrl": "https://sentry.io/api/0"
  },
  "DebugEndpoints": {
    "Enabled": false,
    "ApiKey": "CHANGE_ME_DEBUG_ENDPOINTS_API_KEY"
  },
  "Hangfire": {
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "Username": "admin",
      "Password": "CHANGE_ME"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
